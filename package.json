{
  "name": "hq",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc --build && cp -R ./src/api/templates ./build/api/templates && npm run sentry:sourcemaps",
    "startapi": "node -r dotenv/config build/api/app.js",
    "startws": "node -r dotenv/config build/websocket/startWs.js",
    "bstartapi": "tsc && npm run startapi",
    "bstartws": "tsc && npm run startws",
    "devapi": "nodemon --watch src --ext ts --ignore build --exec \"tsc --build && cp -R ./src/api/templates ./build/api/templates && npm run startapi\"",
    "dev": "concurrently --names \"API,WS\" --prefix-colors \"blue,green\" \"PORT=8080 nodemon --watch src --ext ts --ignore build --exec \\\"tsc --build && cp -R ./src/api/templates ./build/api/templates && PORT=8080 npm run startapi\\\"\" \"WSPORT=8081 nodemon --watch src --ext ts --ignore build --exec \\\"tsc --build && WSPORT=8081 npm run startws\\\"\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org canobal --project hqtv ./build && sentry-cli sourcemaps upload --org canobal --project hqtv ./build",
    "generatetoken": "tsx -r dotenv/config src/scripts/generateToken.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@sentry/cli": "^2.40.0",
    "@sentry/node": "^8.49.0",
    "@sentry/profiling-node": "^8.49.0",
    "@types/compression": "^1.8.1",
    "@vvo/tzdb": "^6.198.0",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "better-all": "^0.0.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "currency.js": "^2.0.4",
    "discord.js": "^14.20.0",
    "dotenv": "^16.3.1",
    "dots-wrapper": "^3.11.16",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validation": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "mysql2": "^3.9.1",
    "nanoid": "^3.3.7",
    "number-to-words": "^1.2.4",
    "percent-round": "^2.3.1",
    "pino": "^8.19.0",
    "pino-logflare": "^0.4.2",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.10",
    "sequelize": "^6.37.1",
    "sharp": "^0.33.2",
    "url-pattern": "^1.0.3",
    "uuid": "^9.0.1",
    "validator": "^13.15.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/common-tags": "^1.8.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.11",
    "@types/number-to-words": "^1.2.2",
    "@types/uuid": "^9.0.5",
    "@types/ws": "^8.5.12",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
